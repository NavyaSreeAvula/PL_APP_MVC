@model IEnumerable<Basicdetail>
@{
}
<a href="">Approved Applications</a>
<a href="">Rejected Applications</a>

<h1>Applications In Progress</h1>

<table>
    <thead>
        <tr>
            <th>App Id</th>
            <th>Load Id</th>
            <th>Customer Name</th>
            <th>View..</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Basicdetail app in Model)
        {
            <tr>
                <td>@app.Id</td>
                <td>@app.Leadid</td>
                <td>@app.Firstname &nbsp; @app.Lastname</td>
                <td><a href="Manager/ViewApplication?id=@app.Id">View App Details</a></td>
            </tr>
        }
    </tbody>
</table>
